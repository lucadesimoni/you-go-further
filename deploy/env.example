# You Go Further — production environment
#
# Copy to `prod.env`, fill in, keep it out of git, and check it before deploying:
#
#   npm run preflight -- deploy/prod.env
#
# Everything the app needs is here. Anything you leave unset has a development
# default, and `npm run preflight` tells you which of those defaults would be
# wrong in production instead of letting you find out from a customer.

# ---- Identity of this deployment -------------------------------------------
APP_ENV=production
PORT=8787
HOST=0.0.0.0
# Set when a proxy you control terminates TLS in front of this process. It is
# what makes per-IP rate limits count real clients, and what allows HSTS.
TRUST_PROXY=true
# Only needed when the SPA is served from a different origin than the API.
# Single-origin deploys (the container below) can leave it empty.
ALLOWED_ORIGINS=https://yougofurther.ch

# ---- Who runs this (legally required, not decoration) -----------------------
# The app holds health-adjacent data — weight, heart rate, sweat rate, every
# route an athlete has run. The revised FADP and the GDPR both require a named
# controller and a reachable contact for access and erasure requests, and Swiss
# law requires a business offering an online service to identify itself. The
# privacy screen renders these verbatim; unset, it says outright that nobody is
# named, and preflight refuses the deployment.
#
# The address may span lines — use \n, it is rendered as written.
OPERATOR_NAME=Fuel Labs GmbH
OPERATOR_ADDRESS=Musterstrasse 1\n8000 Zürich\nSwitzerland
PRIVACY_CONTACT=privacy@yougofurther.ch
# Where "you agree to our terms" on the sign-in screen actually points.
TERMS_URL=https://yougofurther.ch/terms

# ---- Sessions --------------------------------------------------------------
# openssl rand -hex 32 — a different value per environment, never committed.
AUTH_SECRET=

# The demo persona switcher. On, the API accepts an unauthenticated
# `x-role: owner` header as an owner login. Never true in production.
ALLOW_ROLE_SWITCHING=false

# ---- Database --------------------------------------------------------------
# This is the only place the database is named — the Compose file deliberately
# does not override it, so what preflight checks is what the app connects to.
#
# The container in deploy/compose (POSTGRES_PASSWORD comes from your shell):
#   DATABASE_URL=postgres://ygf:CHANGE_ME@db:5432/ygf
#
# Or a managed PostgreSQL from a Swiss provider — the better choice as soon as
# the data matters. `sslmode=require` is not optional across a network, and
# managed offerings generally insist on it anyway.
STORE_BACKEND=postgres
DATABASE_URL=postgres://ygf:CHANGE_ME@db.example.ch:5432/ygf?sslmode=require

# ---- Transactional email (magic-link sign-in) ------------------------------
# SMTP submission — a Swiss mailbox, no third-country processor involved.
# Port 465 is TLS from the first byte; 587 needs MAIL_SMTP_STARTTLS=true.
# Percent-encode the user and password: an @ or : in a password breaks the URL.
MAIL_SMTP_URL=smtps://no-reply%40yougofurther.ch:CHANGE_ME@mail.infomaniak.com:465
MAIL_FROM=no-reply@yougofurther.ch
# MAIL_SMTP_STARTTLS=true
# MAIL_SMTP_CLIENT_NAME=yougofurther.ch
#
# Or an HTTP transactional provider instead (Resend, Brevo, Postmark, Mailgun):
# MAIL_API_URL=https://api.example/emails
# MAIL_API_KEY=
#
# Or ship without email sign-in — deliberately, and say so:
# ALLOW_CONSOLE_MAIL=true

# ---- Device & training providers (optional; dev stubs used if unset) -------
ENABLED_PROVIDERS=strava,garmin,polar,suunto
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=

# ---- Social sign-in (public client ids, safe in the SPA) -------------------
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# ---- Payments (only if you sell subscriptions) -----------------------------
# Both or neither: a secret key without a webhook secret means settlement
# webhooks cannot be verified, which is a free subscription for anyone who
# can POST to the endpoint.
SUBSCRIPTIONS_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Swiss geodata ---------------------------------------------------------
# swisstopo and MeteoSwiss are key-less public services. Override only if
# MeteoSwiss moves its open-data endpoint again.
# METEOSWISS_STATIONS_URL=

# ---- Analytics egress (optional, off by default) ---------------------------
# Note this one leaves Switzerland unless your Databricks workspace does not.
EXPORT_ENABLED=false
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
# DATABRICKS_WAREHOUSE_ID=
# DATABRICKS_TABLE=

# ---- Backups (deploy/backup/pg-backup.sh) ----------------------------------
# S3-compatible object storage — Infomaniak Swiss Backup / Public Cloud Object
# Storage, Exoscale SOS, or any other bucket that stays in Switzerland.
# BACKUP_S3_ENDPOINT=https://s3.pub1.infomaniak.cloud
# BACKUP_S3_BUCKET=ygf-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_RETENTION_DAYS=30
# Encrypts each dump before it leaves the host. Without it, the backup is
# readable by anyone who can read the bucket.
# BACKUP_AGE_RECIPIENT=
