# You Go Further on Elestio — the service's Environment tab, as a file.
#
# Elestio writes the variables you set in the dashboard to `.env` beside the
# compose file. This is that file's shape, with the values Elestio's platform
# already decides for you filled in and the rest marked CHANGE_ME.
#
# Check it before it runs — the same command CI runs, and the same one the
# container runs on itself at start-up:
#
#   cp deploy/elestio/env.example deploy/elestio/.env
#   $EDITOR deploy/elestio/.env
#   npm run preflight -- deploy/elestio/.env
#
# `deploy/env.example` is the fully annotated reference; everything optional is
# documented there and works here unchanged.

# ---- Identity of this deployment -------------------------------------------
APP_ENV=production
PORT=8787
HOST=0.0.0.0
# Elestio's reverse proxy terminates TLS in front of this container, so the
# forwarded-for header is one we control and can trust. This is what makes
# per-IP rate limits count real clients instead of counting the proxy once.
TRUST_PROXY=true
# The hostname Elestio serves this on — its own *.vm.elestio.app name until you
# attach a custom domain, then the custom one. Single-origin deploy, so this
# only matters if you later serve the SPA from somewhere else.
ALLOWED_ORIGINS=https://CHANGE_ME.vm.elestio.app

# The host port Elestio's proxy forwards to, on the Docker bridge. Confirm it
# against the port shown for the service; 8787 is only this app's default.
APP_PORT=8787

# ---- Who runs this (legally required, not decoration) -----------------------
# The app holds health-adjacent data — weight, heart rate, sweat rate, every
# route an athlete has run. Unset, the privacy screen names nobody as
# responsible for it and preflight refuses the deployment.
OPERATOR_NAME=CHANGE_ME GmbH
OPERATOR_ADDRESS=CHANGE_ME 1\n8000 Zürich\nSwitzerland
PRIVACY_CONTACT=privacy@CHANGE_ME.ch
TERMS_URL=https://CHANGE_ME.ch/terms

# ---- Sessions --------------------------------------------------------------
# openssl rand -hex 32 — a different value per environment, never committed.
# Set this one as a *secret* in the Elestio dashboard, not as a plain variable.
AUTH_SECRET=CHANGE_ME

# The demo persona switcher. On, the API serves an unauthenticated request
# carrying `x-role: owner` as an owner. Never true here.
ALLOW_ROLE_SWITCHING=false

# ---- Database --------------------------------------------------------------
# The `db` container in the compose file beside this. `POSTGRES_PASSWORD` must
# be the same value — it is what that container initialises the role with.
#
# No sslmode: the connection never leaves the Docker network. Elestio's own
# managed Postgres is the better choice as soon as this data matters to someone
# other than you — point DATABASE_URL at it (with ?sslmode=require, because that
# one *does* cross a network), remove the `db` service, and backups and failover
# become the platform's problem instead of yours.
STORE_BACKEND=postgres
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://ygf:CHANGE_ME@db:5432/ygf

# ---- Transactional email (magic-link sign-in) ------------------------------
# Without this, magic links go to the container log and nobody outside the
# operations team can create an account — a dead end that looks like a working
# deploy, which is why preflight blocks on it.
MAIL_SMTP_URL=smtps://no-reply%40CHANGE_ME.ch:CHANGE_ME@mail.infomaniak.com:465
MAIL_FROM=no-reply@CHANGE_ME.ch
#
# Or ship without email sign-in — deliberately, and say so out loud. Google and
# Apple sign-in still work; preflight downgrades to a warning rather than
# letting "we decided not to" look identical to "we forgot".
# ALLOW_CONSOLE_MAIL=true

# ---- Device & training providers (optional; dev stubs used if unset) -------
ENABLED_PROVIDERS=strava,garmin,polar,suunto
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# ---- Payments --------------------------------------------------------------
# Off for the Swiss Phase-1 launch: the app is free and earns on affiliate
# commission. Turning it on without both Stripe values is a blocker.
SUBSCRIPTIONS_ENABLED=false

# ---- Analytics egress ------------------------------------------------------
# This one leaves the country unless your Databricks workspace does not.
EXPORT_ENABLED=false
